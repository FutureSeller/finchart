    "@finchart/tools": "workspace:*",
    "@finchart/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "catalog:typedoc",
    "vitepress": "2.0.0-alpha.19",
    "vitepress-plugin-llms": "^1.13.5",
    "vitest": "catalog:",
    "vue": "^3.5.41"
  }
}
