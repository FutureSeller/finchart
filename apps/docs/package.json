    "test": "vitest run",
    "clean": "rm -rf dist api .vitepress/cache .turbo"
  },
  "devDependencies": {
    "@finchart/core": "workspace:*",
    "@finchart/dom": "workspace:*",
    "@finchart/indicators": "workspace:*",
