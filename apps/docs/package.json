{
  "name": "charts-docs",
  "version": "0.0.1",
  "private": true,
  "description": "The @finchart user documentation site",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:showcase && typedoc && vitepress dev",
    "build": "pnpm run build:showcase && typedoc && vitepress build",
    "build:showcase": "pnpm --filter charts-demo-react exec vite build --base ./ --outDir ../docs/public/demos/react-showcase --emptyOutDir",
    "deploy": "pnpm --workspace-root exec turbo run build --filter=charts-docs && wrangler pages deploy dist --project-name=finchart-docs --branch=main",
    "preview:pages": "wrangler pages dev dist --ip 127.0.0.1",
    "typedoc": "typedoc",
    "preview": "vitepress preview",
    "lint": "oxlint .vitepress/config.ts vitest.config.ts zero-coverage-reporter.ts snippets",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist api public/demos/react-showcase .vitepress/cache .turbo"
  },
  "devDependencies": {
    "@finchart/core": "workspace:*",
    "@finchart/dom": "workspace:*",
    "@finchart/indicators": "workspace:*",
    "@finchart/react": "workspace:*",
    "@finchart/tools": "workspace:*",
    "@finchart/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "charts-demo-react": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "catalog:typedoc",
    "vitepress": "2.0.0-alpha.19",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "catalog:",
    "vue": "^3.5.43",
    "wrangler": "4.147.0"
  }
}
