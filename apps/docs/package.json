{
  "name": "charts-docs",
  "version": "0.0.1",
  "private": true,
  "description": "The @finchart user documentation site",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "typedoc && vitepress dev",
    "build": "typedoc && vitepress build",
    "typedoc": "typedoc",
    "preview": "vitepress preview",
    "lint": "oxlint .vitepress/config.ts vitest.config.ts",
