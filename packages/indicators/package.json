{
  "name": "@finchart/indicators",
  "version": "0.0.1",
  "description": "Financial indicators for @finchart/core — MA, MACD, Bollinger, RSI, Ichimoku and more as computation nodes: compute once, feed many drawings.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "lint": "oxlint src",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist .turbo .tsbuildinfo",
    "size": "size-limit",
    "check:publish": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm"
  },
  "peerDependencies": {
    "@finchart/core": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@finchart/core": "workspace:*",
    "@finchart/tsconfig": "workspace:*",
    "@size-limit/preset-small-lib": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "chart",
    "financial",
    "indicators",
    "sma",
    "macd",
    "bollinger"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finchart/finchart.git",
    "directory": "packages/indicators"
  },
  "homepage": "https://github.com/finchart/finchart/tree/main/packages/indicators",
  "bugs": "https://github.com/finchart/finchart/issues",
  "type": "module"
}
