/**
 * **Build only.** Type checking is `tsconfig.test.json`'s job.
 *
 * One file doing both, with `**\/*.test.tsx` as its only exclude, leaves two
 * holes: (1) fixtures in `__tests__/` **ship** as `dist/__tests__/`, and (2)
 * `type-check` **never looks at** the other test files. That matters because
 * CI's `react-floor` job runs `type-check` against React 18 — where 18 and 19
 * diverge is in types like RefObject — and vitest only transpiles, so
 * nothing else looks at those types.
 *
 * The same shape as the other four (core, dom, indicators, tools).
 */
{
  "extends": "@finchart/tsconfig/react.json",
  "compilerOptions": {
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["dist", "**/__tests__/**", "vitest.config.ts"]
}
