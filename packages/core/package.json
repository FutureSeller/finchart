{
  "name": "@finchart/core",
  "version": "0.0.1",
  "description": "Headless financial chart engine — candlestick/line/area series, panes, real-time updates, drawing commands without a DOM. Zero dependencies.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./headless": {
      "types": "./dist/headless.d.mts",
      "default": "./dist/headless.mjs"
    },
    "./authoring": {
      "types": "./dist/authoring.d.mts",
      "default": "./dist/authoring.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/headless.ts src/authoring.ts --format esm --dts",
    "dev": "tsdown src/index.ts src/headless.ts src/authoring.ts --format esm --dts --watch",
    "lint": "oxlint src",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist .turbo .tsbuildinfo",
    "size": "size-limit",
    "check:publish": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@finchart/tsconfig": "workspace:*",
    "@size-limit/preset-small-lib": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "chart",
    "financial",
    "candlestick",
    "canvas",
    "headless",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finchart/finchart.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/finchart/finchart/tree/main/packages/core",
  "bugs": "https://github.com/finchart/finchart/issues",
  "type": "module"
}
