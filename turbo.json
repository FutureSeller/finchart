{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    ".env*",
    "CHANGELOG.md",
    "README.md"
  ],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        ".next/**",
        "build/**"
      ],
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "env": ["FINCHART_SKIP_STRESS"],
      "outputs": [
        "coverage/**"
      ],
      "cache": false,
      "dependsOn": [
        "build"
      ]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"],
      "outputs": [],
      "cache": true,
      "dependsOn": []
    },
    "type-check": {
      "outputs": [],
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "dev": {
      "outputs": [
        "dist/**"
      ],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "size": {
      "cache": false,
      "dependsOn": [
        "build"
      ]
    },
    "check:publish": {
      "cache": false,
      "dependsOn": [
        "build"
      ]
    }
  }
}
